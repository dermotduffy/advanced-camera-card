{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Vite",
      "type": "shell",
      "command": "yarn",
      "args": ["start"],
      "problemMatcher": {
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^build started",
          "endsPattern": "^built in"
        }
      },
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      }
    }
  ]
}
